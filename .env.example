# ─────────────────────────────────────────────────────────────
# MathDOC environment variables — TEMPLATE (safe to commit).
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored. NEVER put real keys in this file.
# Restart `next dev` after changing any of these.
# ─────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED — the app crashes on every request without these) ──
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Dashboard → Project Settings → API → "service_role" secret.
# Grants admin access — NEVER expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret that authenticates Supabase's "Send SMS" auth hook when it
# calls /api/auth/sms-hook. Set the same value in the Supabase hook config.
SUPABASE_AUTH_HOOK_SECRET=

# ── App ──
# Public base URL, used to build links inside SMS messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cloudflare R2 storage ──
# Optional in dev (falls back to local disk uploads), REQUIRED in production —
# without it every upload returns 503. The bucket must stay private; all access
# is via presigned URLs. R2_SECRET_ACCESS_KEY is a SECRET.
# The browser PUTs directly to R2, so the bucket also needs a CORS rule
# allowing PUT/GET from your site's origin — see docs/deployment.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mathdoc-files

# ── Hutch Bulk SMS gateway (REQUIRED — student login OTP goes through this) ──
# Credentials come from your Hutch service agent. There is no simulated
# fallback: without these, students cannot log in and no SMS is sent.
# The password is a SECRET — .env.local only, never committed.
HUTCH_SMS_USERNAME=
HUTCH_SMS_PASSWORD=
# The approved sender mask shown on the recipient's handset (e.g. "MathDOC").
# Hutch must approve the mask before it will work.
HUTCH_SMS_MASK=
# Override only if Hutch gives you a different host.
HUTCH_SMS_BASE_URL=https://bsms.hutch.lk/api

# ── Web Push (VAPID) ──
# Generate a fresh pair with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY is a SECRET — it belongs in .env.local only. A real key
# was committed here previously; treat any key that has ever appeared in this
# file as public and rotate it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
